<div class="container main-content">
    <form class="search-form logged-form" method="post">
        @Html.CustomValidationSummary(true)
        <div class="rw">
            <div class="lbl">Текуща парола:</div>
            <div class="vl">
                @Html.Password("currentPassword", "", new { autofocus = "autofocus" })
            </div>
        </div>
        <div class="rw">
            <div class="lbl">Нова парола:</div>
            <div class="vl">
                @Html.Password("newPassword")
            </div>
        </div>
        <div class="rw">
            <div class="lbl">Нова парола(потвърди):</div>
            <div class="vl">
                @Html.Password("confirmPassword", "", new { @class = "form-control input-sm" })
            </div>
        </div>
        <div class="rw">
            <div class="lbl"></div>
            <div class="vl clearfix">
                <input type="submit" class="search-submit" value="ПРОМЕНИ" />
            </div>
        </div>
    </form>
</div>

@Html.Partial(MVC.Shared.Views._FooterPartial)

