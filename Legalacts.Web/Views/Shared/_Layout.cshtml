<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta http-equiv="Content-Language" content="bg">
    <meta name="description" content="публикувани съдебни актове">
    <meta name="keywords" content="съд, съдебен, акт, дело, заповед, присъда, протокол, разпореждане, решение, определение, постановление, споразумение, гражданско, наказателно, административно">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>
        @if (ViewBag.Title != null)
        {
            <text>@ViewBag.Title</text>
        }
        else
        {
            <text>Публикувани съдебни актове</text>
        }
    </title>
    @Styles.Render("~/Content/css")
    <link href='https://fonts.googleapis.com/css?family=Open+Sans:400,300,600,700,800&subset=latin,cyrillic' rel='stylesheet' type='text/css'>

</head>
<body>
<div class="loader">
    <div id="canvasloader-container" class="wrapper">
        <span>Моля, изчакайте!</span>
    </div>
</div>
@{
    string currentAction = ViewContext.RouteData.Values["action"].ToString();
    string currentController = ViewContext.RouteData.Values["controller"].ToString();
}

@if (Request.IsAuthenticated 
    && currentController.Equals(MVC.Admin.Name, StringComparison.InvariantCultureIgnoreCase)
     && !currentAction.Equals(MVC.Admin.ActionNames.LogOn, StringComparison.InvariantCultureIgnoreCase))
{
    <div class="bg-inner">
        @Html.Partial(MVC.Shared.Views._HeaderPartial)
    </div>
    
    <div class="user-menu">
        @Html.ActionLink("Търсене", MVC.Admin.ActionNames.Search, MVC.Admin.Name, null, new { @class = currentAction.Equals(MVC.Admin.ActionNames.Search, StringComparison.InvariantCultureIgnoreCase) ? "active" : "" })
        @Html.ActionLink("Смяна на парола", MVC.Admin.ActionNames.ChangePassword, MVC.Admin.Name, null, new { @class = currentAction.Equals(MVC.Admin.ActionNames.ChangePassword, StringComparison.InvariantCultureIgnoreCase) ? "active" : "" })
        @Html.ActionLink("Управление на номенклатури", MVC.Admin.ActionNames.Nomenclatures, MVC.Admin.Name, null, new { @class = currentAction.Equals(MVC.Admin.ActionNames.Nomenclatures, StringComparison.InvariantCultureIgnoreCase) ? "active" : "" })
        @Html.ActionLink("Брой актове", MVC.Admin.ActionNames.Acts, MVC.Admin.Name, null, new { @class = currentAction.Equals(MVC.Admin.ActionNames.Acts, StringComparison.InvariantCultureIgnoreCase) ? "active" : "" })
        @Html.ActionLink("Изход", MVC.Admin.ActionNames.LogOff, MVC.Admin.Name)
    </div>
}

@RenderBody()

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/select2")
@Scripts.Render("~/bundles/bootstrap")
@Scripts.Render("~/bundles/canvasloader")
@Scripts.Render("~/bundles/custom")
@RenderSection("scripts", required: false)
    <script>
      (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
      (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
      m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
      })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');

      ga('create', 'UA-61694850-17', 'auto');
      ga('send', 'pageview');
    </script>
</body>
</html>
